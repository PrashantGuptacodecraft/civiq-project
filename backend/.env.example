# ─── CivIQ Environment Variables ──────────────────────────────────────────────
# Copy this file to .env (or backend/.env) and populate the values

# Database Connection (PostgreSQL 15+ recommended)
DATABASE_URL="postgresql://postgres:civiq123@localhost:5432/civiq?schema=public"

# Server Configuration
PORT=8000
NODE_ENV=development
API_BASE_URL="http://localhost:8000"

# Security & Sessions
JWT_SECRET="civiq-development-secret-key-32-characters-minimum"
SESSION_SECRET="civiq-session-secret-change-in-production-2026"

# SMS OTP Provider (Optional for dev — OTP is logged to server console when unset)
# MSG91_AUTH_KEY=""
# MSG91_TEMPLATE_ID=""

# Google OAuth (Optional — for Google Sign-In)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# AI / Vision (Optional — for AI evidence audit & vision categorization)
# GEMINI_API_KEY=""
