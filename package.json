{
  "name": "civiq",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.12.4"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "dev:backend": "pnpm --filter @civiq/backend dev",
    "dev:frontend": "pnpm --filter @civiq/frontend dev",
    "test": "pnpm -r --if-present test",
    "test:backend": "pnpm --filter @civiq/backend test",
    "test:frontend": "pnpm --filter @civiq/frontend test",
    "build": "pnpm -r --if-present build"
  }
}
