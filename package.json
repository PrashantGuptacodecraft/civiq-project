{
  "name": "civiq",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "shared/contracts",
    "shared/auth",
    "shared/db",
    "shared/observability"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:backend": "npm --workspace=@civiq/backend run dev",
    "dev:frontend": "npm --workspace=@civiq/frontend run dev",
    "test": "npm run test --workspaces --if-present",
    "test:backend": "npm --workspace=@civiq/backend run test",
    "test:frontend": "npm --workspace=@civiq/frontend run test",
    "build": "npm run build --workspaces --if-present"
  }
}
