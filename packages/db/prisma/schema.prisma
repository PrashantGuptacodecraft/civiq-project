// CivIQ Database Schema — Foundation
// Conventions:
//   - Primary keys: CUID2 (string, @default(cuid()))
//   - Timestamps: createdAt / updatedAt on every table
//   - Soft-delete: deletedAt (nullable DateTime) on entities that require it
//   - Optimistic locking: version Int @default(0) on mutable aggregates
//   - All timestamps stored as UTC (default Prisma behavior with PostgreSQL)

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMERATIONS
// ─────────────────────────────────────────────

enum Role {
  PLATFORM_SUPER_ADMIN
  NATIONAL_ADMIN
  STATE_ADMIN
  DISTRICT_ULB_ADMIN
  DEPARTMENT_OFFICER
  VERIFICATION_OFFICER
  FIELD_SUPERVISOR
  FIELD_WORKER
  DISASTER_COORDINATOR
  AUDITOR
  CITIZEN
}

enum VerificationStatus {
  PENDING
  IN_REVIEW
  VERIFIED
  REJECTED
  SUSPICIOUS
}

enum IssueStatus {
  DRAFT
  SUBMITTED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  REOPENED
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ─────────────────────────────────────────────
// USERS & IDENTITY
// ─────────────────────────────────────────────

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  BANNED
}

enum UserVerificationLevel {
  UNVERIFIED
  BASIC_VERIFIED
  KYC_VERIFIED
}

/// Platform user — represents any authenticated principal.
model User {
  id                    String             @id @default(cuid())
  email                 String?            @unique
  phone                 String?            @unique
  /// Hashed; never store plaintext or Aadhaar numbers.
  role                  Role               @default(CITIZEN)
  
  status                AccountStatus      @default(ACTIVE)
  verificationLevel     UserVerificationLevel @default(UNVERIFIED)
  
  emailVerifiedAt       DateTime?
  phoneVerifiedAt       DateTime?
  termsAcceptedAt       DateTime?
  privacyPolicyAcceptedAt DateTime?

  passwordHash          String?
  failedLoginAttempts   Int                @default(0)
  lockedUntil           DateTime?

  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  deletedAt             DateTime?
  version               Int                @default(0)

  profile               UserProfile?
  privacyPreferences    PrivacyPreference?
  sessions              Session[]
  passwordResetTokens   PasswordResetToken[]
  oauthAccounts         OAuthAccount[]
  issues                Issue[]            @relation("ReportedBy")
  assigned              Issue[]            @relation("AssignedTo")
  roleAssignments       RoleAssignment[]
  invitesSent           OfficialInvite[]   @relation("InvitedBy")
  invitesAccepted       OfficialInvite[]   @relation("AcceptedBy")
  trustProfile          TrustProfile?

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

/// Linked external identity providers (Google, Apple, etc)
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// Extended profile — kept separate to allow selective loading. Public/semi-public fields.
model UserProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  avatarUrl   String?
  bio         String?
  state       String?
  district    String?
  city        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

/// User privacy and notification preferences.
model PrivacyPreference {
  id            String   @id @default(cuid())
  userId        String   @unique
  showRealName  Boolean  @default(false)
  shareLocation Boolean  @default(false)
  allowContact  Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("privacy_preferences")
}

enum TrustLevel {
  NEW
  ESTABLISHED
  TRUSTED
  FLAGGED
  SUSPENDED
}

/// Dynamic trust score tracking
model TrustProfile {
  id                 String       @id @default(cuid())
  userId             String       @unique
  
  trustScore         Float        @default(50.0)
  trustLevel         TrustLevel   @default(NEW)
  
  validReports       Int          @default(0)
  rejectedReports    Int          @default(0)
  confirmedAbuse     Int          @default(0)
  
  lastRecalculatedAt DateTime     @default(now())
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([trustLevel])
  @@map("trust_profiles")
}

/// OTP Authentication Challenges
model OtpChallenge {
  id          String   @id @default(cuid())
  phone       String
  /// Hashed OTP value for verification
  otpHash     String
  attempts    Int      @default(0)
  expiresAt   DateTime
  verifiedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([phone])
  @@map("otp_challenges")
}

/// Active user sessions
model Session {
  id              String   @id @default(cuid())
  userId          String
  tokenHash       String   @unique
  deviceInfo      String?
  ipAddress       String?
  isRevoked       Boolean  @default(false)
  authenticatedAt DateTime @default(now())
  lastActiveAt    DateTime @default(now())
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("sessions")
}

/// Password reset tokens
model PasswordResetToken {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────
// ISSUES
// ─────────────────────────────────────────────

/// A civic issue reported by a citizen or field worker.
model Issue {
  id                 String             @id @default(cuid())
  title              String
  description        String
  status             IssueStatus        @default(SUBMITTED)
  severity           IssueSeverity      @default(MEDIUM)
  verificationStatus VerificationStatus @default(PENDING)
  /// WGS-84 latitude
  latitude           Float?
  /// WGS-84 longitude
  longitude          Float?
  address            String?
  state              String?
  district           String?
  city               String?
  reportedById       String
  assignedToId       String?
  /// Optimistic lock — increment on every state change.
  version            Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  reportedBy User  @relation("ReportedBy", fields: [reportedById], references: [id])
  assignedTo User? @relation("AssignedTo", fields: [assignedToId], references: [id])

  evidence IssueEvidence[]

  @@index([status])
  @@index([severity])
  @@index([verificationStatus])
  @@index([reportedById])
  @@index([state, district])
  @@index([deletedAt])
  @@map("issues")
}

// ─────────────────────────────────────────────
// EVIDENCE
// ─────────────────────────────────────────────

/// File or media evidence attached to an issue.
model IssueEvidence {
  id           String    @id @default(cuid())
  issueId      String
  /// Relative path or object-store key — never a public URL by default.
  storageKey   String
  mimeType     String
  sizeBytes    Int
  uploadedById String?
  capturedAt   DateTime?
  createdAt    DateTime  @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@map("issue_evidence")
}

// ─────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────

/// Immutable append-only audit trail.
model AuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  actorType      String   @default("HUMAN") // "HUMAN" or "SYSTEM"
  action         String
  objectType     String?
  objectId       String?
  jurisdictionId String?
  requestId      String?
  /// JSON snapshot of changed fields — no PII/secrets stored directly.
  payload        Json     @default("{}")
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  // Note: We avoid strict foreign keys for objectId to allow polymorphic logging 
  // and prevent audit logs from blocking deletions of objects (though soft-delete is preferred).

  @@index([actorId])
  @@index([objectType, objectId])
  @@index([jurisdictionId])
  @@index([requestId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// JURISDICTIONS
// ─────────────────────────────────────────────

enum JurisdictionType {
  COUNTRY
  STATE_UT
  DISTRICT
  LOCAL_BODY
  BLOCK
  WARD_VILLAGE
}

/// Administrative boundaries and hierarchies for routing and reporting
model Jurisdiction {
  id        String           @id @default(cuid())
  name      String
  type      JurisdictionType
  /// Local Government Directory code or other external reference ID
  lgdCode   String?          @unique
  parentId  String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?
  version   Int              @default(0)

  parent   Jurisdiction?  @relation("JurisdictionHierarchy", fields: [parentId], references: [id])
  children Jurisdiction[] @relation("JurisdictionHierarchy")
  organizations Organization[]
  roleAssignments RoleAssignment[]

  @@index([type])
  @@index([parentId])
  @@index([deletedAt])
  @@map("jurisdictions")
}

// ─────────────────────────────────────────────
// ORGANIZATIONS & DEPARTMENTS
// ─────────────────────────────────────────────

enum OrganizationType {
  GOVERNMENT
  NGO
  CONTRACTOR
  CIVIC_GROUP
}

enum OrgVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// A structured body (Government, NGO, Contractor) operating within a jurisdiction
model Organization {
  id                 String                @id @default(cuid())
  name               String
  type               OrganizationType
  verificationStatus OrgVerificationStatus @default(PENDING)
  jurisdictionId     String
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  deletedAt          DateTime?
  version            Int                   @default(0)

  jurisdiction       Jurisdiction          @relation(fields: [jurisdictionId], references: [id])
  departments        Department[]
  roleAssignments    RoleAssignment[]
  invites            OfficialInvite[]

  @@index([jurisdictionId])
  @@index([type])
  @@index([verificationStatus])
  @@index([deletedAt])
  @@map("organizations")
}

/// A subdivision of an organization that handles specific categories of issues
model Department {
  id               String       @id @default(cuid())
  name             String
  organizationId   String
  /// Array of issue categories this department handles
  issueCategories  String[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roleAssignments  RoleAssignment[]
  invites          OfficialInvite[]

  @@index([organizationId])
  @@map("departments")
}

// ─────────────────────────────────────────────
// RBAC / ACCESS CONTROL
// ─────────────────────────────────────────────

/// Represents a specific role granted to a user, optionally scoped to a jurisdiction, organization, or department.
model RoleAssignment {
  id             String    @id @default(cuid())
  userId         String
  role           Role
  
  // Scopes (all optional, if all null => global scope)
  jurisdictionId String?
  organizationId String?
  departmentId   String?
  
  createdAt      DateTime  @default(now())

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  jurisdiction   Jurisdiction? @relation(fields: [jurisdictionId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])
  department     Department?   @relation(fields: [departmentId], references: [id])

  @@unique([userId, role, jurisdictionId, organizationId, departmentId], name: "unique_role_assignment")
  @@index([userId])
  @@index([role])
  @@map("role_assignments")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

/// Invitation for a government official or contractor to join an organization/department
model OfficialInvite {
  id                 String       @id @default(cuid())
  email              String
  employeeIdentifier String?
  role               Role
  tokenHash          String       @unique
  status             InviteStatus @default(PENDING)
  expiresAt          DateTime

  organizationId     String
  departmentId       String?
  invitedById        String
  acceptedById       String?
  acceptedAt         DateTime?
  
  createdAt          DateTime     @default(now())

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department         Department?  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  invitedBy          User         @relation("InvitedBy", fields: [invitedById], references: [id])
  acceptedBy         User?        @relation("AcceptedBy", fields: [acceptedById], references: [id])

  @@index([email])
  @@index([tokenHash])
  @@index([organizationId])
  @@map("official_invites")
}

// ─────────────────────────────────────────────
// INTEGRATIONS & PROVENANCE
// ─────────────────────────────────────────────

enum IntegrationType {
  GOVERNMENT_API
  SENSOR_NETWORK
  SCRAPER
  MANUAL_IMPORT
  THIRD_PARTY_SERVICE
}

/// A data source or remote system providing data into CivIQ
model IntegrationSource {
  id            String          @id @default(cuid())
  name          String
  type          IntegrationType
  isActive      Boolean         @default(true)
  /// 0-100 score indicating trustworthiness of this source
  confidence    Int             @default(50)
  syncCursor    String?
  lastSyncAt    DateTime?
  lastSuccessAt DateTime?
  errorState    Json?           // Structured error info if the last sync failed
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  references    ExternalReference[]

  @@map("integration_sources")
}

/// Links local records (Issues, Jurisdictions, Users) to remote IDs and tracks provenance
model ExternalReference {
  id            String   @id @default(cuid())
  integrationId String
  /// e.g. "Jurisdiction", "Issue", "User"
  objectType    String
  /// The local ID of the record
  objectId      String
  /// The ID of this record in the remote integration system
  externalId    String
  /// Any additional provenance metadata from the source
  metadata      Json?    @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  integration   IntegrationSource @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, objectType, externalId])
  @@index([objectType, objectId])
  @@index([integrationId])
  @@map("external_references")
}
